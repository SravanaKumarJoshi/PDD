# MySQL is the only database used by the application.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=polysaccharide_selector

# FastAPI uses a SQLAlchemy URL built from the same MySQL instance.
DATABASE_URL=mysql+aiomysql://your_mysql_user:your_mysql_password@localhost:3306/polysaccharide_selector
