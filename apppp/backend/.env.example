# =============================================================================
# BioPolymer Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in every value before starting the server.
# NEVER commit the real .env file to version control.
#
# Three environment profiles are supported:
#   development  — local developer machine, HTTP allowed, debug on, docs on
#   staging      — pre-production server, HTTPS required, docs on
#   production   — live server, HTTPS required, docs off, strict validation
#
# To switch profile: set APP_ENV=<profile> in the .env file or the shell.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=development
# APP_ENV=staging
# APP_ENV=production

# Show detailed tracebacks and SQL logs. Set to false in staging/production.
APP_DEBUG=true

# Bind address for uvicorn (docker-compose overrides this via CMD).
# 0.0.0.0 is required when the API is accessed by the Android emulator
# via 10.0.2.2 — do NOT change this to 127.0.0.1 or the emulator cannot reach it.
# Also ensure docker-compose.yml uses "8000:8000" (not "127.0.0.1:8000:8000")
# for the same reason.
APP_HOST=0.0.0.0
APP_PORT=8000

# Public-facing base URL of this API (used by OpenAPI docs and URL generation).
# Development:  http://localhost:8000
# Staging:      https://api-staging.yourdomain.com
# Production:   https://api.yourdomain.com
API_BASE_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# DATABASE  (MySQL — used for users, projects, and the material catalog)
# -----------------------------------------------------------------------------
# Format: mysql+aiomysql://user:password@host:port/database
#
# Development (matches docker-compose.yml):
DATABASE_URL=mysql+aiomysql://root:meheer17@localhost:3306/polysaccharide_selector

# Staging / Production — use a managed MySQL service and strong credentials:
# DATABASE_URL=mysql+aiomysql://<user>:<password>@<host>:3306/<db>?ssl=true
#
# Individual MySQL env vars (used by the Streamlit src/data.py MySQL loader).
# These must always match the host/port/db/user/pass in DATABASE_URL above.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=polysaccharide_selector
MYSQL_USER=root
MYSQL_PASSWORD=meheer17


# -----------------------------------------------------------------------------
# FIREBASE AUTH
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Place your Firebase service-account JSON at backend/firebase-service-account.json
# and ensure it is listed in .gitignore.


# -----------------------------------------------------------------------------
# ADMIN
# Required: Must be a cryptographically random string (≥32 chars).
# The server refuses to start in staging/production if this is empty or a
# well-known placeholder value.
#
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(40))"
# -----------------------------------------------------------------------------
ADMIN_TOKEN=


# -----------------------------------------------------------------------------
# CORS — allowed browser / mobile origins
#
# Provide a JSON array of strings.  Only origins listed here can call the API
# from a browser.  The Android app is unaffected by CORS but is listed here
# for documentation purposes.
#
# Development (multiple local dev servers):
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# Staging:
# CORS_ORIGINS=["https://staging.yourdomain.com"]

# Production (add every frontend domain that will call this API):
# CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# RATE LIMITING
# Default limit applied to every endpoint unless overridden per-route.
# Format: "<count>/<period>"  e.g. "100/minute", "1000/hour"
# -----------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=60/minute


# -----------------------------------------------------------------------------
# FILE UPLOAD
# Maximum size for CSV imports in bytes (default 10 MB).
# -----------------------------------------------------------------------------
MAX_CSV_UPLOAD_BYTES=10485760


# -----------------------------------------------------------------------------
# SCORING
# -----------------------------------------------------------------------------
SCORING_CONFIG_VERSION=1.0.0
